
  <div class="post-card card mb-4">
    <div class="post-images">
      <% if ramen_post.images.attached? %>
        <%= image_tag ramen_post.images.first,
                        class: "img-fluid rounded mb-3",
                        style: "max-height: 300px; object-fit: cover;" %>
      <% else %>
        <%= image_tag "no_image.png",
                        class: "img-fluid rounded mb-3",
                        style: "max-height: 300px; object-fit: cover;" %>
      <% end %>
    </div>
    <div class="card-body">
      <div class="card-left mb-4 d-flex justify-content-between align-items-center w-100">
        <div class="d-flex align-items-center gap-2">
          <% if ramen_post.user.avatar.attached? %>
            <%= image_tag ramen_post.user.avatar,
                    class: "rounded-circle border-4",
                    style: "width: 35px; height: 35px;",
                    alt: "ユーザーのプロフィール画像" %>
          <% else %>
            <i class="fa-regular fa-circle-user show-icon" style="width: 35px; height: 35px; font-size: 35px;"></i>
          <% end %>
          <div class="d-flex flex-column">
            <span class="fw-bold"><%= ramen_post.user.name %></span>
            <small class="text-muted"><%= ramen_post.created_at.strftime("%m/%d %H:%M") %></small>
          </div>
        </div>
        <div class="d-flex align-items-center">
          <%= render "shared/like_button", ramen_post: ramen_post %>
        </div>
      </div>
      <p class="card-title fs-5 fw-bold mb-2"><%= ramen_post.title %></p>
      <div class="mb-3">
        <label class="fw-semibold">ジャンル</label>
        <p class="form-control-plaintext">
          <%= I18n.t("activerecord.attributes.ramen_post.genres.#{ramen_post.genre}") %>
        </p>
      </div>
      <div class="d-flex justify-content-between align-items-center">
        <div id="star-rating" class="d-flex gap-1">
          <% 5.times do |i| %>
            <% value = (i + 1) * 0.5 %>
            <% if value <= ramen_post.rating.to_f %>
              <span class="star fs-4 text-warning">★</span>
            <% else %>
              <span class="star fs-4 text-secondary">★</span>
            <% end %>
          <% end %>
        </div>
        <%= link_to "投稿詳細へ", ramen_post_path(ramen_post), data: { turbo: false },class: "detail-link text-secondary" %>
      </div>
    </div>
  </div>
