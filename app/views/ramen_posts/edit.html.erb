<div class="container-fluid p-0">
  <div class="position-relative w-100" style="height: 300px; max-height: 300px;">
    <%= image_tag "title_logo.jpeg", class: "img-fluid w-100 h-100", style: "object-fit: cover; filter: brightness(60%);", alt: "タイトル画像" %>
    <div class="position-absolute top-50 start-50 translate-middle text-white text-center" >
      <h1 class="display-4 fw-bold ">投稿編集</h1>
    </div>
  </div>
</div>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
          <div class="text-center mb-5">
            <%= render "form", ramen_post: @ramen_post %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

