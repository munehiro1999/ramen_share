<div class="container-fluid p-0">
  <div class="position-relative w-100" style="height: 300px; max-height: 300px;">
    <%= image_tag "title_logo.jpeg", class: "img-fluid w-100 h-100", style: "object-fit: cover; filter: brightness(60%);", alt: "タイトル画像" %>
    <div class="position-absolute top-50 start-50 translate-middle text-white text-center" >
      <h1 class="display-4 fw-bold ">投稿詳細</h1>
      <%= link_to "投稿一覧へ", ramen_posts_path, class: " btn  btn-primary text-white shadow-sm mb-3"%>
    </div>
  </div>
</div>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
          <div class="post-images mb-4 d-flex flex-wrap justify-content-start gap-3">
            <% if @ramen_post.images.attached? %>
              <% @ramen_post.images.each do |image| %>
                <div class="image-wrapper" style="width: 250px; height: 250px; overflow: hidden; border-radius: 8px;">
                  <%= image_tag url_for(image),
                      class: "img-fluid",
                      style: "width: 100%; height: 100%; object-fit: cover;" %>
                </div>
              <% end %>
            <% else %>
              <div class="image-wrapper" style="width: 250px; height: 250px; overflow: hidden; border-radius: 8px;">
                <%= image_tag "no_image.png",
                    class: "img-fluid",
                    style: "width: 100%; height: 100%; object-fit: cover;" %>
              </div>
            <% end %>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">ラーメンの名前or店名</label>
            <p class="form-control-plaintext"><%= @ramen_post.title %></p>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">ジャンル</label>
            <p class="form-control-plaintext"><%= @ramen_post.genre.humanize %></p>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">評価</label>
            <div id="star-rating" class="d-flex gap-1">
              <% 5.times do |i| %>
                <% value = (i + 1) * 0.5 %>
                <% if value <= @ramen_post.rating.to_f %>
                  <span class="star fs-3 text-warning">★</span>
                <% else %>
                  <span class="star fs-3 text-secondary">★</span>
                <% end %>
              <% end %>
            </div>
          </div>
          <div class="mb-5">
            <label class="form-label fw-semibold">概要</label>
            <p class="form-control-plaintext"><%= @ramen_post.description %></p>
          </div>
          <div >
            <% if @ramen_post.user == current_user %>
              <%= link_to "編集する", edit_ramen_post_path(@ramen_post), class: "btn btn-lg btn-warning text-white fw-bold shadow-sm mb-3" %>
              <%= link_to "削除する", ramen_post_path(@ramen_post), method: :delete, data: { confirm: "本当に削除しますか?" }, class: "btn btn-lg btn-danger text-white fw-bold shadow-sm mb-3"%>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
