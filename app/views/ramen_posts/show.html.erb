<div class="d-flex justify-content-center align-items-center">
  <h2>詳細</h2>
</div>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

          <% if @ramen_post.image.attached? %>
            <div class="mb-4 text-center">
              <%= image_tag @ramen_post.image, class: "img-fluid rounded", style: "max-height: 300px; object-fit: cover;" %>
            </div>
          <% end %>

          <div class="mb-3">
            <label class="form-label fw-semibold">ラーメンの名前or店名</label>
            <p class="form-control-plaintext"><%= @ramen_post.title %></p>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">ラーメンタイプ</label>
            <p class="form-control-plaintext"><%= @ramen_post.genre.humanize %></p>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">評価</label>
            <div id="star-rating" class="d-flex gap-1">
              <% 5.times do |i| %>
                <% value = (i + 1) * 0.5 %>
                <% if value <= @ramen_post.rating.to_f %>
                  <span class="star fs-3 text-warning">★</span>
                <% else %>
                  <span class="star fs-3 text-secondary">★</span>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">概要</label>
            <p class="form-control-plaintext"><%= @ramen_post.description %></p>
          </div>

          <div class="d-grid">
            <%= link_to "編集する", edit_ramen_post_path(@ramen_post), class: "btn btn-lg btn-warning text-white fw-bold shadow-sm" %>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
