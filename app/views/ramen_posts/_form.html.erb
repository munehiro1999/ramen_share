<%= form_with(model: ramen_post) do |f| %>
  <div class="mb-3 ">
    <%= f.label :title, "ラーメンの名前or(店名)", class: "form-label fw-semibold" %>
    <%= f.text_field :title,
                    class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :genre, "ラーメンタイプ", class: "form-label fw-semibold" %>
    <%= f.select :genre, RamenPost.genres.keys.map { |g| [g.humanize, g] },
                    { prompt: "ジャンルを選択" },
                    class: "form-select" %>
  </div>
  <div class="mb-3">
    <%= f.label :rating, "評価", for: "rating-input", class: "form-label fw-semibold" %>
    <div id="star-rating" class="d-flex gap-1" data-rating="<%= @ramen_post.rating || 0 %>">
      <% 5.times do |i| %>
        <% value = (i + 1) * 0.5 %>
        <span class="star fs-3 text-secondary" data-value="<%= value %>">★</span>
      <% end %>
    </div>
    <%= f.hidden_field :rating, id: "rating-input", value: @ramen_post.rating || 0 %>
  </div>
  <div class="mb-3">
    <div class="d-flex justify-content-between">
      <%= f.label :description, "概要", class: "form-label fw-semibold" %>
    </div>
    <%= f.text_area :description,
                    rows: 4,
                    maxlength: 400,
                    class: "form-control",
                    placeholder: "感想や特徴などコメントしてね" %>
  </div>
  <div class="mb-4">
    <%= f.label :image, "写真をアップロード", class: "form-label fw-semibold" %>
    <div class="border border-2 border-dashed rounded-3 p-4 text-center bg-light">
      <div class="mb-2 text-muted">
        <i class="bi bi-cloud-upload fs-1"></i>
      </div>
      <%= f.file_field :image, class: "form-control" %>
    </div>
  </div>
  <% if @ramen_post.new_record? %>
    <div class="d-grid">
      <%= f.submit "投稿する",class: "btn btn-lg btn-warning text-white fw-bold shadow-sm" %>
    <% else %>
      <%= f.submit "編集完了する", class: "btn btn-lg btn-warning text-white fw-bold shadow-sm"%>
    </div>
  <% end %>
<% end %>
