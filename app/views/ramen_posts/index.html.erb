<div class="container-fluid p-0">
  <div class="position-relative w-100" style="height: 600px; min-height: 400px; max-height: 500px;">
    <%= image_tag "ramen_top.png", class: "img-fluid w-100 h-100", style: "object-fit: cover; filter: brightness(60%);", alt: "トップ画像" %>
    <div class="position-absolute top-50 start-50 translate-middle text-white text-center" >
      <h1 class="display-4 fw-bold bg-orange-400">RamenShare</h1>
      <p class="lead">RamenShareは、食べたラーメンを投稿して共有するサービスです!<br>
        今すぐにおすすめのラーメンを共有しよう！</p>
    </div>
  </div>
</div>
<div class="title-text text-center mb-4 mt-4">
  <h2 class="section-title">投稿一覧</h2>
</div>
<div class="main-container">
  <% @ramen_posts.each do |ramen_post| %>
    <div class="post-card card">
      <div class="post-images">
        <% if ramen_post.images.attached? %>
          <!-- 最初の1枚だけ表示 -->
          <%= image_tag ramen_post.images.first,
                        class: "img-fluid rounded mb-3",
                        style: "max-height: 300px; object-fit: cover;" %>
        <% else %>
          <%= image_tag "no_image.png",
                        class: "img-fluid rounded mb-3",
                        style: "max-height: 300px; object-fit: cover;" %>
        <% end %>
      </div>
      <div class="card-body">
        <div class="card-left mb-4 d-flex align-items-center gap-2">
          <% if ramen_post.user.avatar.attached? %>
            <%= image_tag ramen_post.user.avatar,
                          class: "rounded-circle border border-4 border-primary",
                          alt: "ユーザーのプロフィール画像" %>
          <% else %>
            <i class="fa-regular fa-circle-user show-icon fs-2"></i>
          <% end %>
          <div class="fs-6">
            <%= ramen_post.user.name %>
            <small class="text-muted"><%= ramen_post.created_at.strftime("%m/%d %H:%M") %></small>
          </div>
        </div>
        <div class="card-right mb-3">
          <p class="card-title fs-5 fw-bold mb-4"><%= ramen_post.title %></p>
          <div class="mb-3">
            <label class="fw-semibold">ジャンル</label>
            <p class="form-control-plaintext"><%= ramen_post.genre.humanize %></p>
          </div>
          <div class="d-flex justify-content-between align-items-center mt-auto">
            <div id="star-rating" class="d-flex gap-1">
              <% 5.times do |i| %>
                <% value = (i + 1) * 0.5 %>
                <% if value <= ramen_post.rating.to_f %>
                  <span class="star fs-4 text-warning">★</span>
                <% else %>
                  <span class="star fs-4 text-secondary">★</span>
                <% end %>
              <% end %>
            </div>
            <%= link_to "投稿詳細へ", ramen_post_path(ramen_post), class: "detail-link text-secondary" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
