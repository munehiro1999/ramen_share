<header class="bg-white border-bottom shadow-sm fixed-top">
  <div class="header-container d-flex justify-content-between">
    <div class="header-left d-flex align-items-center gap-4">
      <%= link_to users_path, class: "d-flex align-items-center text-decoration-none" do %>
        <%= image_tag "ramenshare.jpg", alt: "ロゴ", height: "70", class: "me-2 d-block mb-0 p-0"%>
      <% end %>
      <%= link_to "home", class: "nav-link text-dark ms-4"%>
      <%= link_to "投稿", class: "nav-link text-dark"%>
    </div>
    <div class="header-right d-flex align-items-center">
      <% if logged_in? %>
        <div class="dropdown me-4">
          <a class="btn btn-light dropdown-toggle" href="#" role="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" >
            メニュー
          </a>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
            <li><%= link_to "ユーザー詳細", user_path(current_user), class: "dropdown-item" %></li>
            <li><%= link_to "ログアウト", logout_path, method: :delete, class: "dropdown-item"%></li>
          </ul>
        </div>
      <% else %>
        <%= link_to "ログイン", login_path, class: "nav-link text-dark me-2"%>
        <%= link_to "新規登録", signup_path, class: "btn btn-outline-primary me-4" %>
      <% end %>
    </div>
  </div>
</header>
