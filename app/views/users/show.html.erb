<div class="container mt-5">
  <div class="border rounded p-4 shadow-sm bg-light w-100 w-md-75 w-lg-50 mx-auto text-center">
    <div class="position-relative d-inline-block mb-3">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar,
              class: "rounded-circle border border-2",
              style: "object-fit: cover; width: 130px; height: 100px;",
              alt: "ユーザーのプロフィール画像"%>
      <% else %>
        <i class="fa-regular fa-circle-user show-icon"></i>
      <% end %>
    </div>
    <h2 class="h4 fw-bold mb-1"><%= @user.name %></h2>
    <p class="text-muted mb-3"><%= @user.email %></p>
    <%= link_to "ユーザー編集", edit_user_path(@user), class: "btn btn-primary" %>
  </div>
</div>
<div class="conntainer m-4">
  <div class="d-flex justify-content-center mb-4">
    <%= link_to "投稿一覧", my_posts_user_path(@user),
        data: { turbo_frame: "user-posts-frame", turbo_action: "replace" },
        class: "tab-link tab-active" %>
    <%= link_to "いいねした投稿", liked_posts_user_path(@user),
        data: { turbo_frame: "user-posts-frame", turbo_action: "replace" },
        class: "tab-link tab-active" %>
  </div>
</div>
<%= turbo_frame_tag "user-posts-frame" do %>
  <%= render "users/my_posts", posts: @ramen_posts %>
<% end %>
