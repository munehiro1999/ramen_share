<h2>ログイン画面</h2>

<%= form_with url: login_path, method: :post do |f|%>
  <div>
    <%= label_tag :email %><br>
    <%= email_field_tag :email %>
  </div>

  <div>
    <%= label_tag :password %><br>
    <%= password_field_tag :password %>
  </div>

  <%= submit_tag "ログイン" %>
<% end %>

<%= link_to "新規登録", signup_path %>
