<div class="d-flex justify-content-center align-items-center mt-5">
  <div class="border rounded p-4 shadow-sm bg-light w-75 w-md-50 w-xl-40">
    <%= form_with url: login_path, method: :post do |f| %>
      <div class="mb-3">
        <%= label_tag :email, "メールアドレス" %>
        <%= email_field_tag :email, nil, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= label_tag :password, "パスワード" %>
        <%= password_field_tag :password, nil, class: "form-control" %>
      </div>
      <%= submit_tag "ログイン", class: "btn btn-outline-primary mb-3 w-100" %>
    <% end %>
    <div class="mb-4 text-center">
      <%= link_to "新規登録", signup_path %>
    </div>
  </div>
</div>
